/nvngx_*.dll

# NVIDIA NGX feature runtimes (user-supplied, not redistributed)
third_party/nvidia-ngx/runtime/


# NeuralScreen NGX NR worker runtime (user-supplied, not redistributed)
third_party/neuralscreen/


# User-provided mod archives (not redistributed)
*.rar

# Rust build output
ui/target/

# FSR signed runtimes (downloaded with the AMD FSR SDK 2.4 package)
third_party/amd-fsr/signedbin/
# D3D12 debug layer (dev only; D3D12Core.dll is shipped)
third_party/agility-sdk/x64/d3d12SDKLayers.dll
